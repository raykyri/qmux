# Copy to .env (git-ignored) and fill in what you need. Every variable here is
# read by a qmux build or release script; nothing in this file is required to
# run `npm run dev` or the unit tests.

# --- macOS notarization (scripts/build.sh, scripts/release.sh) ---
# App Store Connect credentials used to notarize a signed release build.
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
# "Developer ID Application: …" identity used to codesign. Auto-detected by
# scripts/release.sh when exactly one identity is installed.
APPLE_SIGNING_IDENTITY=

# --- Tauri updater signing (scripts/build.sh, scripts/release.sh) ---
# Private updater signing key: the key contents or a path to the key file.
# When unset, the scripts fall back to ~/.tauri/qmux-updater.key.
TAURI_SIGNING_PRIVATE_KEY=
# Passphrase for that key, read by the Tauri bundler when it signs updater
# artifacts. Leave empty for a key without a passphrase.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --- GitHub publishing (src-tauri/src/publishing.rs) ---
# OAuth app client id for the publishing device flow:
# https://github.com/settings/developers → New OAuth App → enable Device Flow.
# The device flow uses no client secret. Read at runtime, and baked in via
# option_env! when set at build time, so publishing works in a shipped bundle.
QMUX_GITHUB_CLIENT_ID=

# The OpenRouter API key is NOT an environment variable: it is entered in
# Settings and stored in the owner-only preferences file
# (AppPreferences.open_router_key), never in the webview's localStorage.
