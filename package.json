{
  "name": "qmux",
  "private": true,
  "version": "0.3.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:site": "tsx watch web/server.tsx",
    "dev:tauri": "tauri dev",
    "build": "bash scripts/build.sh",
    "build:aarch": "QMUX_BUILD_TARGET=aarch64-apple-darwin bash scripts/build.sh",
    "build:remote-cli": "bash scripts/build-remote-cli.sh",
    "build:release": "bash scripts/release.sh",
    "build:site:frontend": "tsc && vite build",
    "build:site:server": "tsc -p web/tsconfig.json && esbuild web/server.tsx --bundle --packages=external --platform=node --format=esm --target=node20 --outfile=dist-site/server.mjs",
    "start:site": "node dist-site/server.mjs",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "npm run test:unit && npm run test:integration && npm run test:plugins && npm run test:rust",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test web/server.test.ts web/comments.test.ts",
    "test:plugins": "npm run test:opencode-plugin && npm run test:pi-extension && npm run test:cursor-plugin",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:app-shortcuts": "node --import tsx --test tests/appShortcuts.test.ts",
    "test:terminal-attention": "node --import tsx --test tests/terminalAttention.test.ts",
    "test:completion-sounds": "node --import tsx --test tests/completionSounds.test.ts",
    "test:native-terminal-keyboard": "node --import tsx --test tests/nativeTerminalKeyboard.test.ts",
    "test:native-terminal-layout": "node --import tsx --test tests/nativeTerminalLayout.test.ts",
    "test:terminal-title": "node --import tsx --test tests/terminalTitle.test.ts",
    "test:active-workspace": "node --import tsx --test tests/activeWorkspace.test.ts",
    "test:composer-slash-commands": "node --import tsx --test tests/composerSlashCommands.test.ts",
    "test:home-rails": "node --import tsx --test tests/homeRails.test.ts",
    "test:claude-turns": "node --import tsx --test tests/claudeTurns.test.ts",
    "test:pane-splits": "node --import tsx --test tests/paneSplits.test.ts",
    "test:sidebar-controls": "node --import tsx --test tests/sidebarControls.test.ts",
    "test:context-menu-placement": "node --import tsx --test tests/contextMenuPlacement.test.ts",
    "test:research-highlights": "node --import tsx --test tests/researchHighlights.test.ts",
    "test:research-navigation": "node --import tsx --test tests/researchNavigation.test.ts",
    "test:research-events": "node --import tsx --test tests/researchEvents.test.ts",
    "test:research-history": "node --import tsx --test tests/researchHistory.test.ts",
    "test:research-folders": "node --import tsx --test tests/researchFolders.test.ts",
    "test:journal": "node --import tsx --test tests/journal.test.ts",
    "test:research-documents": "node --import tsx --test tests/researchDocuments.test.ts",
    "test:research-conversations": "node --import tsx --test tests/researchConversations.test.ts",
    "test:research-threads": "node --import tsx --test tests/researchThreads.test.ts",
    "test:image-markers": "node --import tsx --test tests/imageMarkers.test.ts",
    "test:image-lightbox": "node --import tsx --test tests/imageLightbox.test.ts",
    "test:markdown-math": "node --import tsx --test tests/markdownMath.test.ts",
    "test:transcript-artifacts": "node --import tsx --test tests/transcriptArtifacts.test.ts tests/links.test.ts",
    "test:artifact-tray": "node --import tsx --test tests/artifacts.test.ts",
    "test:research-prompt-markdown": "node --import tsx --test tests/researchPromptMarkdown.test.ts",
    "test:tagged-instructions": "node --import tsx --test tests/taggedInstructions.test.ts",
    "test:research-instruction-setting": "node --import tsx --test tests/researchInstructionSetting.test.ts",
    "test:thread-graph-overlay": "node --import tsx --test tests/threadGraphOverlay.test.ts",
    "test:workspace-scope": "node --import tsx --test tests/workspaceScope.test.ts",
    "test:turn-timeline": "node --import tsx --test tests/turnTimeline.test.ts",
    "test:transcript-scroll": "node --import tsx --test tests/transcriptScroll.test.ts",
    "test:handoff": "node --import tsx --test tests/handoff.test.ts",
    "test:publication": "node --import tsx --test tests/publication.test.ts tests/publicationComments.test.ts web/server.test.ts web/comments.test.ts",
    "test:opencode-plugin": "node --experimental-default-type=module --test qmux-opencode-plugin/tests/*.test.mjs",
    "test:pi-extension": "node --test qmux-pi-extension/tests/*.test.mjs",
    "test:cursor-plugin": "node --test qmux-cursor-plugin/tests/*.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@viz-js/viz": "^3.28.0",
    "dompurify": "3.4.14",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-mathjax": "^7.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
