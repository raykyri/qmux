{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for qmux-owned application webviews.",
  "webviews": ["main", "global-task-launcher"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-theme",
    "clipboard-manager:allow-write-text"
  ]
}
