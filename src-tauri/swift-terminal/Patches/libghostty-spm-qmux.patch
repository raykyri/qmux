+    /// The host retains rejected bytes for retry; never buffer them here too.
+    @discardableResult
+    func enqueueWrite(
+        _ data: Data,
+        beforeWrite: @escaping @Sendable () -> Void,
+        afterWrite: @escaping @Sendable () -> Void
+    ) -> Bool {
+        condition.lock()
+        defer { condition.unlock() }
+        guard surface != nil else { return false }
+        let writeGeneration = generation
+        outputQueue.async { [self] in
+            withSurface(generation: writeGeneration) { surface in
+                beforeWrite()
+                defer { afterWrite() }
+                write(surface, data)
+            }
+        }
+        return true
+    }
