+import Foundation
+
+#if canImport(AppKit) && !canImport(UIKit)
+    import AppKit
+
+    public struct TerminalSelectionSnapshot: Sendable, Equatable {
+        public let text: String
+        public let viewportOffsetStart: UInt32
+        public let viewportOffsetLength: UInt32
+        public let startPointX: Double
+        public let baselinePointY: Double
+
+        public init(
+            text: String,
+            viewportOffsetStart: UInt32,
+            viewportOffsetLength: UInt32,
+            startPointX: Double,
+            baselinePointY: Double
+        ) {
+            self.text = text
+            self.viewportOffsetStart = viewportOffsetStart
+            self.viewportOffsetLength = viewportOffsetLength
+            self.startPointX = startPointX
+            self.baselinePointY = baselinePointY
+        }
+    }
+
+    extension AppTerminalView {
+        public var isSurfaceLive: Bool { surface != nil }
+
+        public func readSelectedText() -> String? { surface?.readSelection() }
+
+        /// Use the exact host-approved text without reading the pasteboard again.
+        @discardableResult
+        public func pasteApprovedText(_ text: String) -> Bool {
+            guard let surface else { return false }
+            core.bridge.pendingPasteText = text
+            let dispatched = surface.performBindingAction("paste_from_clipboard")
+            if !dispatched { core.bridge.pendingPasteText = nil }
+            return dispatched
+        }
+
+        /// Selection text and viewport-relative cell geometry. The offset is
+        /// trustworthy only when the embedding host observed a fully-contained
+        /// gesture; this API intentionally makes no containment claim.
+        public func readSelectionSnapshot() -> TerminalSelectionSnapshot? {
+            guard let selected = surface?.readSelectionResult() else { return nil }
+            return TerminalSelectionSnapshot(
+                text: selected.text,
+                viewportOffsetStart: selected.offsetStart,
+                viewportOffsetLength: selected.offsetLength,
+                startPointX: selected.startPointX,
+                baselinePointY: selected.baselinePointY
+            )
+        }
+
+        /// Current grid and cell dimensions in backing pixels.
+        public func terminalGridMetrics() -> TerminalGridMetrics? {
+            surface?.size()
+        }
+    }
+#endif
