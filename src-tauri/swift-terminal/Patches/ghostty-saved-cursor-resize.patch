 }

+test "Terminal: resize trims blank rows below saved cursor" {
+    const alloc = testing.allocator;
+    // Include a larger screen so trimming crosses page boundaries.
+    for ([_]u16{ 44, 150 }) |rows| {
+        for ([_]u16{ 1, 16, 34 }) |cursor_row| {
+            for ([_]u16{ 20, 30, rows - 1 }) |saved_row| {
+                var t = try init(testing.io, alloc, .{ .cols = 125, .rows = rows });
+                defer t.deinit(alloc);
+                t.setCursorPos(saved_row + 1, 5);
+                t.saveCursor();
+                t.setCursorPos(cursor_row + 1, 1);
+                try t.printString("prompt> ");
+
+                try t.resize(alloc, .{ .cols = 125, .rows = 21 });
+                try testing.expectEqual(@min(cursor_row, 20), t.screens.active.cursor.y);
+                try testing.expectEqual(8, t.screens.active.cursor.x);
+
+                // Restoring a saved position in a removed blank row must remain
+                // valid, clamped to the last retained row.
+                t.restoreCursor();
+                const scrolled = cursor_row - @min(cursor_row, 20);
+                try testing.expectEqual(@min(saved_row -| scrolled, 20), t.screens.active.cursor.y);
+                try testing.expectEqual(4, t.screens.active.cursor.x);
+            }
+        }
+    }
+}
