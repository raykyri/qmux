{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "noEmit": true,
    // The landing page's enhancement script ships as plain JS (no build step for
    // the client), so it is type-checked here from its JSDoc annotations.
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./client/*.js",
    "../site/mockup.js",
    "../src/lib/publication.ts",
    "../src/lib/publicationComments.ts"
  ]
}
